# ==========================================
# BODRUM LUXURY TRANSFER - ENVIRONMENT VARIABLES
# ==========================================

# 1. Gemini AI API Key (Yapay Zeka Asistanı İçin)
# https://aistudio.google.com/app/apikey adresinden alınabilir:
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase Veritabanı (Rezervasyon & Ayarlar Depolama)
# https://supabase.com projenizden alınabilir:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# 3. Cloudinary (Fotoğraf & Video Medya Depolama)
# https://cloudinary.com konsolundan alınabilir:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Port (Vercel otomatik ayarlar, yerel geliştirme için 3000):
PORT=3000
